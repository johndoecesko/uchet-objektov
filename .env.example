APP_NAME="Учёт объектов"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Europe/Moscow

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Для быстрого старта — SQLite. На сервере — MySQL/MariaDB:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=uchet
# DB_USERNAME=uchet
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# На HTTPS-сервере включите:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Почта: подтверждение регистрации, сброс пароля, приглашения. log — письма только в storage/logs.
# SMTP ящика на хостинге (пример reg.ru): MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_HOST=mail.hosting.reg.ru,
# MAIL_PORT=465, MAIL_USERNAME=noreply@ваш-домен, MAIL_PASSWORD=пароль ящика, MAIL_FROM_ADDRESS = тот же ящик
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Бот в MAX для чеков: токен от @MasterBot и секрет вебхука (5–256 символов A-Z a-z 0-9 _ -).
# После заполнения: php artisan max:webhook-set
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# Копия бэкапов в облако по WebDAV (необязательно). Nextcloud, ссылка «только загрузка»:
# URL = https://<nextcloud>/public.php/webdav, USER = токен из ссылки, PASSWORD = пароль ссылки
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=

# Подсказки заказчика по ИНН/названию и адреса (https://dadata.ru/api/suggest/).
# Бесплатного тарифа хватает. Пусто — поля заполняются вручную.
DADATA_TOKEN=

# Регистрация: true — открыта всем (по почте), пусто — только по приглашению в организацию
REGISTRATION_ENABLED=

# Яндекс SmartCaptcha на регистрации и сбросе пароля (https://yandex.cloud/ru/docs/smartcaptcha/). Пусто — без капчи
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Оператор персональных данных — для /privacy и /terms (config/legal.php). LEGAL_DRAFT=false — убрать пометку «черновик»
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_SHORT=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_DRAFT=true
